# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Next.js build output
/.next
/out
.kiro
.claude

# Dependencies
/node_modules
/.pnp
.pnp.js

# Compiled Sanity Studio
/dist

# Temporary Sanity runtime, generated by the CLI on every dev server start
/.sanity

# Logs
/logs
*.log

# Coverage directory used by testing tools
/coverage

# Misc
.DS_Store
*.pem

# Typescript
*.tsbuildinfo

# Dotenv and similar local-only files
*.local
.env
.env.*
*.env

# Dev/test scripts (not needed in production)
/scripts

# Test files
*.test.ts
*.test.tsx
*.spec.ts
*.spec.tsx
__tests__/

# Playwright
/playwright-report
/test-results
/playwright/.cache
.last-run.json