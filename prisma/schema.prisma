
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  resumes   Resume[]
}

model Resume {
  id            String   @id @default(uuid())
  userId        String
  profile       Profile?
  skills        Json?    // Store as JSON array of skill objects
  experience    Json?    // Store as JSON array of experience objects  
  education     Json?    // Store as JSON array of education objects
  certificates  Json?    // Store as JSON array of certificate objects
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Profile {
  id        String @id @default(uuid())
  fullname  String
  email     String
  phone     String
  location  String
  links     Json?    // Store as JSON array of link objects
  summary   String
  resume    Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  resumeId  String @unique
}
